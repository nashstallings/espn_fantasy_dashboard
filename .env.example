# Copy to backend/.env for local development. NEVER commit a filled-in copy.

# --- Secrets (Secret Manager in Cloud Run) -----------------------------------
# 32-byte AES-256-GCM key, base64 encoded. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=

# HMAC secret for session JWTs. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Shared secret required by POST /internal/sync (Cloud Scheduler -> Cloud Run).
SYNC_TOKEN=

# --- Storage -----------------------------------------------------------------
# "firestore" in deployed environments, "memory" for local dev/tests.
CREDENTIAL_STORE=memory
GCP_PROJECT=
FIRESTORE_COLLECTION=espn_credentials

# BigQuery destination for the history/trends snapshots.
BIGQUERY_DATASET=espn_fantasy

# --- Behaviour ---------------------------------------------------------------
# Origins allowed to call the API (the GitHub Pages site).
ALLOWED_ORIGINS=http://localhost:8080,https://nashstallings.github.io
# Seconds a fetched ESPN response is reused before re-fetching.
ESPN_CACHE_TTL_SECONDS=60
# Session lifetime before the user must re-paste cookies.
JWT_TTL_HOURS=720
